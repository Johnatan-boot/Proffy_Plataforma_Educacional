{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "node --import tsx --test",
    "postinstall": "prisma skills sync || exit 0",
    "db:seed": "tsx src/seed.ts",
    "db:generate": "prisma generate --config prisma7.config.ts",
    "db:migrate:deploy": "prisma migrate deploy --config prisma7.config.ts",
    "db:generate:mysql": "prisma generate --config prisma7.config.mysql.ts",
    "db:migrate:deploy:mysql": "prisma migrate deploy --config prisma7.config.mysql.ts",
    "build:production": "npm run db:generate:mysql && tsc",
    "start:production": "DATABASE_PROVIDER=mysql node dist/server.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@prisma/adapter-better-sqlite3": "^7.10.0",
    "@prisma/adapter-mariadb": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "dotenv": "^18.0.4",
    "fastify": "^5.12.4",
    "prisma": "^7.10.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "prisma@7.10.0": true,
    "better-sqlite3@12.11.1": true,
    "@prisma/engines@7.10.0": true,
    "esbuild@0.28.2": true
  }
}
