# Variáveis de ambiente para PRODUÇÃO (Render + Clever Cloud MySQL).
# Nunca commitar o .env real — isto é só um modelo.

# String de conexão do MySQL da Clever Cloud (copie do painel do add-on).
# Formato: mysql://usuario:senha@host:porta/nome_do_banco
DATABASE_URL="mysql://usuario:senha@host:3306/proffy"

# Ativa o client MySQL em vez do SQLite (ver src/lib/prisma.ts)
DATABASE_PROVIDER="mysql"

# URL pública do frontend em produção, para o CORS liberar só ela
CORS_ORIGIN="https://seu-frontend.exemplo.com"

# Porta que o Render injeta automaticamente — não precisa definir manualmente,
# mas o Fastify precisa ler process.env.PORT (ver src/server.ts).
PORT="3000"
